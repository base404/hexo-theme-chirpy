<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
<title><% if (page.title) { %><%= page.title %> | <% } %><%= theme.title || config.title %></title>
<meta name="description" content="<%= page.description || page.excerpt || theme.description || config.description || '' %>">
<meta name="author" content="<%= page.author || theme.author || config.author || '' %>">

<link rel="shortcut icon" href="<%= url_for(theme.favicon || '/favicon.ico') %>">
<link rel="icon" href="<%= url_for(theme.favicon || '/favicon.ico') %>">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap">

<link rel="stylesheet" href="<%= url_for('/css/main.css') %>">

<script>
  (function() {
    try {
      var savedScheme = localStorage.getItem('chirpy_scheme');
      var defaultScheme = '<%= theme.color_scheme || "dark" %>';
      if (savedScheme) {
        document.documentElement.setAttribute('data-scheme', savedScheme);
      } else {
        if (defaultScheme === 'auto') {
          defaultScheme = (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) ? 'light' : 'dark';
        }
        document.documentElement.setAttribute('data-scheme', defaultScheme);
      }
    } catch(e) {}
  })();
</script>

<%- theme.head_code || '' %>

