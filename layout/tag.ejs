<div class="tag-container">
  <h1 class="page-title"><i class="fa-solid fa-tag"></i> 标签: #<%= page.tag %></h1>

  <div class="posts-list">
    <% page.posts.forEach(function(post){ %>
      <article class="post-card post-card-compact">
        <a href="<%= url_for(post.path) %>" class="post-card-overlay-link" aria-label="<%= post.title %>"></a>
        <h2 class="post-card-title">
          <a href="<%= url_for(post.path) %>"><%= post.title || '无标题' %></a>
        </h2>
        <div class="post-meta">
          <span class="meta-item">
            <i class="fa-regular fa-calendar"></i>
            <%= date(post.date, 'YYYY-MM-DD') %>
          </span>
        </div>
      </article>
    <% }); %>
  </div>

  <% if (page.total > 1) { %>
    <nav class="pagination">
      <%- paginator({
        prev_text: '<i class="fa-solid fa-chevron-left"></i> ' + ((theme.pagination && theme.pagination.prev_text) || '上一页'),
        next_text: ((theme.pagination && theme.pagination.next_text) || '下一页') + ' <i class="fa-solid fa-chevron-right"></i>'
      }) %>
    </nav>
  <% } %>
</div>

