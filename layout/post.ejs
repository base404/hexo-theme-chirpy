<article class="post-detail">
  <header class="post-header">
    <h1 class="post-title"><%= page.title %></h1>

    <div class="post-meta">
      <span class="meta-item">
        <i class="fa-regular fa-calendar"></i>
        发布于 <%= date(page.date, 'YYYY-MM-DD') %>
      </span>
      <% if (page.updated && page.updated !== page.date) { %>
        <span class="meta-item">
          <i class="fa-regular fa-clock"></i>
          更新于 <%= date(page.updated, 'YYYY-MM-DD') %>
        </span>
      <% } %>
      <% if (page.categories && page.categories.length) { %>
        <span class="meta-item">
          <i class="fa-regular fa-folder"></i>
          <%= page.categories.data[0].name %>
        </span>
      <% } %>
    </div>
  </header>

  <div class="post-content markdown-body">
    <%- page.content %>
  </div>

  <% if (page.tags && page.tags.length) { %>
    <footer class="post-tags">
      <i class="fa-solid fa-tags"></i>
      <% page.tags.forEach(function(tag){ %>
        <a href="<%= url_for(tag.path) %>" class="tag-badge">#<%= tag.name %></a>
      <% }); %>
    </footer>
  <% } %>

  <% if (page.prev || page.next) { %>
    <nav class="post-navigation">
      <div class="nav-box nav-prev">
        <% if (page.prev) { %>
          <a href="<%= url_for(page.prev.path) %>" rel="prev">
            <span class="nav-sub"><i class="fa-solid fa-arrow-left"></i> 上一篇</span>
            <span class="nav-title"><%= page.prev.title || '无标题' %></span>
          </a>
        <% } %>
      </div>
      <div class="nav-box nav-next">
        <% if (page.next) { %>
          <a href="<%= url_for(page.next.path) %>" rel="next">
            <span class="nav-sub">下一篇 <i class="fa-solid fa-arrow-right"></i></span>
            <span class="nav-title"><%= page.next.title || '无标题' %></span>
          </a>
        <% } %>
      </div>
    </nav>
  <% } %>

  <%- partial('_partial/comments') %>

</article>
